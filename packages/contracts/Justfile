# Habenula wire-contract package recipes

# Show available commands
default:
    @just --list

# No runtime tests of its own: the schemas are exercised by the engine's
# contract test (packages/engine/test/contract/) and both consumers' typechecks.
test:
    @echo "contracts: no package-local tests (covered by engine contract test + consumer typechecks)."

# Emit the published tarball surface: dist/*.js + .d.ts (tsconfig.build.json)
build:
    npx tsc -p tsconfig.build.json

# TypeScript strict type check
typecheck:
    npx tsc --noEmit

# ESLint + dependency pin check
lint:
    npx eslint src/
    node ../../scripts/check-pinned-deps.cjs

# All pre-commit checks: lint, typecheck, test
pre-commit: lint typecheck test
    @echo "Contracts checks passed."
