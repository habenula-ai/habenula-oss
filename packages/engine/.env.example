# Habenula container configuration — the options catalog.
# Your real settings live in .env at the REPOSITORY ROOT, beside
# compose.yaml. Append the lines you need there; the self-host runbook
# (SELF-HOSTING.md at the repository root) creates .env for you.
#
# This file documents the CONTAINER run path (the compose.yaml env_file).
# The wrangler dev loop is separate and reads .dev.vars instead — see
# .dev.vars.example. Never commit .env: it holds real secrets.
#
# Every variable below is read at startup, so recreate the container after any
# change. Full inventory, with what each value is for:
# docs/connect/_index.md.

# REQUIRED — 256-bit AES key for credential encryption at rest (64 hex chars).
# The daemon refuses to start on a missing, malformed, or placeholder key.
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=

# Optional — enables the LLM-driven conversation path. The governance loop
# over the mock connector needs no key at all. Anthropic is the default
# provider (model claude-sonnet-4-6; LLM_MODEL overrides).
#ANTHROPIC_API_KEY=

# Optional — use a non-Anthropic model: any OpenAI-compatible backend
# (Ollama, llama.cpp, vLLM, hosted gateways).
# LLM_ENDPOINT is the base URL — /chat/completions is appended. From inside
# the container a runtime on your host is http://host.docker.internal:<port>/v1,
# never localhost. LLM_API_KEY only if the backend requires one.
#LLM_PROVIDER=openai-compatible
#LLM_ENDPOINT=
#LLM_MODEL=
#LLM_API_KEY=

# Shared-secret caller token for the trusted /internal/mcp drive surface —
# the CLI's chat AND its `status` verb both drive it, so set this to use the
# CLI at all. Unset fails closed (/internal/mcp 401s every request). The CLI
# must send the same value via HABENULA_INTERNAL_MCP_TOKEN.
# Generate with: openssl rand -hex 32
#INTERNAL_MCP_TOKEN=

# Optional — host port published on 127.0.0.1 (default 8787).
#HABENULA_PORT=8787

# Optional — dev observability. Set to exactly `true` to serve the visual
# model page at /dev/model, a live graph of the engine's governed state. Any
# other value, or unset, leaves it and /api/dev/* returning 404. The engine
# reads this at start, so recreate the container after changing it. Leave it
# off unless you are watching the data model: the page and its snapshot API
# are unauthenticated on loopback, like the rest of the local engine.
# See packages/engine/docs/guides/development/visual-model.md.
#VISUAL_MODEL=true

# Optional — debug mode. Set to exactly `true` to serve
# POST /api/tools/execute, which drives one governed tool call with no
# conversation behind it. Any other value, or unset, leaves the route
# returning 404. It is a debugging surface, never an intended feature; the
# test harnesses are its caller. Leave it off unless you are inspecting the
# governance pipeline by hand. The engine reads this at start, so recreate
# the container after changing it.
#DEBUG_MODE=true

# Optional — one OAuth client pair per provider you connect. Each pair
# authorizes the whole provider, so one Google client covers both Gmail and
# Google Calendar. Registering each app is a walkthrough of its own; start at
# docs/connect/_index.md. The mock connector needs no pair.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#MICROSOFT_CLIENT_ID=
#MICROSOFT_CLIENT_SECRET=
#SLACK_CLIENT_ID=
#SLACK_CLIENT_SECRET=
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=

# Optional — loopback guard. Any value except `false` rejects a request whose
# Host is not loopback. Set it to `false` when an OAuth callback arrives
# through a tunnel or any other public origin (Slack needs this).
#LOCALHOST_ONLY=false

# Optional — a stable public origin for the OAuth redirect, set as an ORIGIN
# only (scheme and host). The engine appends the callback path itself. Without
# an override the redirect is built from the incoming request URL, which comes
# out `http://localhost` behind a tunnel — Slack rejects that.
#
# Prefer the per-provider form. `<PROVIDER>` is the uppercased OAuth PROVIDER
# id (GOOGLE, MICROSOFT, SLACK, GITHUB), not the service name you type, so
# Gmail's override is OAUTH_REDIRECT_BASE_URL_GOOGLE and an
# OAUTH_REDIRECT_BASE_URL_GMAIL is silently ignored. The global form moves
# EVERY provider's redirect at once, forcing a re-registration in each
# provider's console.
#OAUTH_REDIRECT_BASE_URL_SLACK=https://your-tunnel.example.com
#OAUTH_REDIRECT_BASE_URL=
